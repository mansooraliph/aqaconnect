// ─────────────────────────────────────────────────────────────────────────
// schema.prisma — Phase 2.0 Foundation
// Only the 8 cross-cutting models (Branch, BranchSettings, User, Role,
// Permission, RolePermission, UserRole, RefreshToken) per MIGRATION_PLAN.md
// §1. Functional-module models (Configuration/HR/Student/Fees/Academic) are
// added in later phases.
// ─────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════

enum RoleScope {
  GLOBAL // branch-agnostic — Super Admin / Management style roles
  BRANCH // scoped to the assigned user's branchId, enforced server-side
}

// ═══════════════════════════════════════════════════════════════════════
// CROSS-CUTTING: BRANCHES, USERS, RBAC, AUTH
// ═══════════════════════════════════════════════════════════════════════

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings  BranchSettings?
  users     User[]
  userRoles UserRole[]

  academicYears    AcademicYear[]
  academicClasses  AcademicClass[]
  academicSections AcademicSection[]
  calendarDays     CalendarDay[]

  employees           Employee[]
  departments         Department[]
  designations        Designation[]
  leaves              Leave[]
  leaveTypes          LeaveType[]
  attendances         Attendance[]
  holidays            Holiday[]
  appreciations       Appreciation[]
  awards              Award[]
  teachers            Teacher[]
  teacherApplications TeacherApplication[]
  announcements       Announcement[]

  admissions    Admission[]
  students      Student[]
  studentLeaves StudentLeave[]

  feeTypes      FeeType[]
  feeStructures FeeStructure[]
  feeDemands    FeeDemand[]
  payments      Payment[]

  lessons   Lesson[]
  halqas    Halqa[]
  examTypes ExamType[]
  exams     Exam[]

  studentExams    StudentExam[]
  progressEntries StudentSurahProgressEntry[]

  notifications Notification[]

  @@index([isActive])
}

// One row per user's home branch relationship; a GLOBAL-scope role user may
// still have a home branchId (their "primary office") purely for record
// purposes — it does not restrict their query scope.
model BranchSettings {
  id             String        @id @default(cuid())
  branchId       String        @unique
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  displayName    String?
  currency       String        @default("INR") // old app hardcoded Rupee; now explicit
  timezone       String        @default("Asia/Kolkata")
  language       String        @default("en")
  logoUrl        String?
  // Added in Phase 2.1 now that AcademicYear exists (deferred from Phase 2.0).
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([academicYearId])
}

model User {
  id           String    @id @default(cuid())
  // Login identifier — admin-settable, any alphanumeric string (may itself
  // look like an email, but isn't validated as one). Replaces email as the
  // login credential; email is now just an optional contact field.
  username     String    @unique
  email        String?   @unique
  passwordHash String
  firstName    String
  lastName     String?
  phone        String?
  whatsapp     String?
  isActive     Boolean   @default(true)
  branchId     String? // nullable: pure-management users may have no home branch
  branch       Branch?   @relation(fields: [branchId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  employee      Employee?
  teacher       Teacher?
  student       Student?

  academicClassesAdded       AcademicClass[] @relation("AcademicClassAddedBy")
  academicClassesLastUpdated AcademicClass[] @relation("AcademicClassLastUpdatedBy")
  halqasAdded                Halqa[]         @relation("HalqaAddedBy")
  halqasLastUpdated          Halqa[]         @relation("HalqaLastUpdatedBy")

  progressEntriesAdded       StudentSurahProgressEntry[] @relation("ProgressEntryAddedBy")
  progressEntriesLastUpdated StudentSurahProgressEntry[] @relation("ProgressEntryLastUpdatedBy")
  progressEntriesVerified    StudentSurahProgressEntry[] @relation("ProgressEntryVerifiedBy")

  attendancesReviewed  Attendance[]   @relation("AttendanceReviewedBy")
  announcementsCreated Announcement[] @relation("AnnouncementCreatedBy")

  deviceTokens  DeviceToken[]
  notifications Notification[]

  @@index([branchId])
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique // e.g. "Super Admin", "Branch Admin", "Teacher", "Accountant"
  description String?
  scope       RoleScope @default(BRANCH)
  isSystem    Boolean   @default(false) // seeded roles, cannot be deleted from UI
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // dot-namespaced, e.g. "fees.demands.generate"
  module      String // "configuration" | "hr" | "student_management" | "fees" | "academic" | "system"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// If role.scope == BRANCH, the assignment is implicitly scoped to the user's
// own branchId at query time. branchId is stored here too (denormalized) so
// a GLOBAL-role user can theoretically be granted a BRANCH-scope role for a
// *specific* branch without changing their home branch.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════
// CONFIGURATION (Phase 2.1)
//
// Trimmed from MIGRATION_PLAN.md's full model bodies: relations to models
// from LATER phases (Lesson, StudentEnrollment, FeeStructure, FeeDemand,
// Admission, Holiday, StudentSurahProgress, SurahHifdhStudentSchedule) are
// deferred and added back when those phases build the other side of the
// relation — same pattern as BranchSettings.academicYearId in Phase 2.0.
// ═══════════════════════════════════════════════════════════════════════

model LessonStage {
  id          String       @id @default(cuid())
  name        String
  description String?
  sortOrder   Int          @default(0)
  status      ActiveStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subStages LessonSubStage[]
  lessons   Lesson[]

  @@index([sortOrder])
}

model LessonSubStage {
  id            String       @id @default(cuid())
  lessonStageId String
  lessonStage   LessonStage  @relation(fields: [lessonStageId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sortOrder     Int          @default(0)
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lessons Lesson[]

  @@index([lessonStageId, sortOrder])
}

// Reference data — the 114 Surahs. Not branch-scoped (shared reference table).
// Field set matches the legacy `surahs` table (juz/page/line range columns
// carried over 1:1); company_id/added_by/last_updated_by/deleted_at were
// deliberately dropped — this table stays global, and no other model in
// this schema uses an audit-by or soft-delete pattern.
model Surah {
  id             String          @id @default(cuid())
  number         Int             @unique // 1-114 (legacy: surah_number)
  nameArabic     String // legacy: name_ar
  nameEnglish    String // legacy: name_en
  totalAyahs     Int
  juzFrom        Int? // legacy: juzuh_from
  juzTo          Int? // legacy: juzuh_to
  pageNumberFrom Int?
  pageNumberTo   Int?
  lineNumberFrom Int?
  lineNumberTo   Int?
  revelationType RevelationType? // legacy: makki_or_madani
  createdAt      DateTime        @default(now())

  pageLines        SurahAyahPageLine[]
  targetSchedules  SurahTargetSchedule[]
  studentSchedules SurahHifdhStudentSchedule[]
  studentProgress  StudentSurahProgress[]
  progressEntries  StudentSurahProgressEntry[]

  @@index([number])
}

enum RevelationType {
  MAKKI
  MADANI
}

// Underlying raw page/line grid (old QuranPageLinesController data entry).
model QuranPage {
  id         String   @id @default(cuid())
  pageNumber Int      @unique
  lineCount  Int      @default(15)
  createdAt  DateTime @default(now())

  ayahPageLines SurahAyahPageLine[]
}

// Maps ayah <-> page/line — reference data curated via import/export.
// Field set matches the legacy `surah_ayah_page_lines` table (juz number
// and a line-range per ayah carried over); company_id/added_by/
// last_updated_by/deleted_at were dropped — same rationale as Surah:
// this stays global, and denormalized surah_name_ar/en/surah_number are
// dropped too since they're already reachable via the surahId relation.
model SurahAyahPageLine {
  id          String    @id @default(cuid())
  surahId     String
  surah       Surah     @relation(fields: [surahId], references: [id], onDelete: Cascade)
  ayahNumber  Int
  juzNumber   Int? // legacy: juz_number
  quranPageId String
  quranPage   QuranPage @relation(fields: [quranPageId], references: [id])
  lineFrom    Int // legacy: line_from
  lineTo      Int // legacy: line_to
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([surahId, ayahNumber])
  @@index([quranPageId])
}

// Day-by-day memorization pacing plan, one row per day, later used to
// generate per-student Hifdh schedules (see SurahHifdhStudentSchedule).
// This is a single global master plan (no scheduleNo grouping — there is
// only ever one target schedule, not several selectable ones). Flattened to
// match the legacy `surah_target_schedules` table; company_id/added_by/
// last_updated_by were dropped — same rationale as Surah/SurahAyahPageLine
// (this stays global; no other model uses an audit-by pattern).
//
// A day can carry several rows (a sabaq + multiple sabqi/manzil revision
// portions on the same day is normal for a real memorization plan — real
// import data has up to 13 rows for a single day), so dayNumber is NOT
// unique. surahId/fromAyah/toAyah/stage are nullable because milestone rows
// ("Preparation day", "Exam Juz 30") carry no surah portion at all — for
// those, the descriptive text goes into examName instead.
model SurahTargetSchedule {
  id                       String            @id @default(cuid())
  sortOrder                Int // display order — preserves import/insertion order rather than resorting by day
  dayNumber                Int // legacy: day
  stage                    ScheduleStage? // legacy: stage enum('Hifdh','Doura','Revision')
  surahId                  String?
  surah                    Surah?            @relation(fields: [surahId], references: [id])
  pageNumberFrom           Int?
  pageNumberTo             Int?
  lineFrom                 Int?
  lineTo                   Int?
  portionDescription       String?
  fromAyah                 Int? // legacy: verse_from
  toAyah                   Int? // legacy: verse_to
  estimatedDurationMinutes Int? // legacy: estimated_duration (time) stored as minutes
  difficultyLevel          DifficultyLevel?
  priority                 SchedulePriority?
  scheduleType             String? // legacy: schedule_type — plain text: "Hifd" / "Preparation" / "Exam"
  examName                 String? // e.g. "Exam Juz 30", "Preparation day" when there's no surah portion
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  hifdhSchedules SurahHifdhStudentSchedule[]

  @@index([surahId])
  @@index([sortOrder])
}

enum ScheduleStage {
  HIFDH
  DOURA
  REVISION
}

enum DifficultyLevel {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum SchedulePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model AcademicYear {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false) // "make current" toggle — only one true per branch, enforced in service layer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSectionYears AcademicClassSectionYear[]
  calendarDays      CalendarDay[]
  branchSettings    BranchSettings[]
  feeStructures     FeeStructure[]
  feeDemands        FeeDemand[]

  @@unique([branchId, name])
  @@index([branchId, isCurrent])
}

model AcademicClass {
  id              String       @id @default(cuid())
  branchId        String
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  code            String? // legacy Mobile App API: unique per branch (nulls excluded from uniqueness)
  sortOrder       Int          @default(0)
  status          ActiveStatus @default(ACTIVE)
  addedById       String? // legacy Mobile App API: audit trail (not used by the modern configuration UI)
  addedBy         User?        @relation("AcademicClassAddedBy", fields: [addedById], references: [id])
  lastUpdatedById String?
  lastUpdatedBy   User?        @relation("AcademicClassLastUpdatedBy", fields: [lastUpdatedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  classSections AcademicClassSection[]
  admissions    Admission[]
  feeStructures FeeStructure[]
  halqas        Halqa[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@index([branchId])
}

model AcademicSection {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  classSections AcademicClassSection[]

  @@unique([branchId, name])
  @@index([branchId])
}

model AcademicClassSection {
  id                String          @id @default(cuid())
  academicClassId   String
  academicClass     AcademicClass   @relation(fields: [academicClassId], references: [id], onDelete: Cascade)
  academicSectionId String
  academicSection   AcademicSection @relation(fields: [academicSectionId], references: [id], onDelete: Cascade)
  capacity          Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  classSectionYears AcademicClassSectionYear[]

  @@unique([academicClassId, academicSectionId])
  @@index([academicSectionId])
}

// One instance of a class-section for a given academic year — generated
// (with a "preview generation" step in the old UI) at the start of each year.
model AcademicClassSectionYear {
  id                     String               @id @default(cuid())
  academicClassSectionId String
  academicClassSection   AcademicClassSection @relation(fields: [academicClassSectionId], references: [id], onDelete: Cascade)
  academicYearId         String
  academicYear           AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  capacity               Int?
  status                 ActiveStatus         @default(ACTIVE)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  studentEnrollments StudentEnrollment[]

  @@unique([academicClassSectionId, academicYearId])
  @@index([academicYearId])
}

// NOTE: "Current Classes" (old Modules/Academic CurrentClassesController) is
// intentionally NOT a table. It is a derived read model — a service-layer
// query joining AcademicClassSectionYear (for the branch's current
// AcademicYear) with StudentEnrollment (status = ACTIVE), aggregated for
// counts/stats. Expose it as a read-only endpoint/view once StudentEnrollment
// exists (Phase 2.3), not a Prisma model.

// Field set matches the legacy `calendar_days` table (day_name/week_number/
// year/holiday_name carried over as plain stored columns — no FK to Holiday,
// per explicit instruction). company_id maps to the existing branchId;
// added_by/last_updated_by dropped — same rationale as Surah (no other
// model here uses an audit-by pattern).
// academicYearId is optional — matching legacy, "Initiate Days" generates a
// full Jan-Dec calendar year independent of any academic year (only the
// pre-existing per-academic-year generate() flow sets it).
model CalendarDay {
  id             String        @id @default(cuid())
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  dayName        String? // legacy: day_name
  weekNumber     Int? // legacy: week_number
  year           Int?
  isWorkingDay   Boolean       @default(true)
  isHoliday      Boolean       @default(false)
  holidayName    String? // legacy: holiday_name (plain text, no FK)
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([branchId, date])
  @@index([academicYearId])
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum LeaveStatus {
  PENDING
  PRE_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  // Mobile clock-in awaiting admin review, and a reviewed-but-declined
  // clock-in — the legacy `AttendanceRequest.approved` (y/n/r) review
  // workflow, folded into the existing per-day Attendance row rather than a
  // parallel table (see mobile-app-api/attendance).
  PENDING_APPROVAL
  REJECTED
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════
// HR (Phase 2.2)
//
// Same trimming rule as Configuration: relations to LATER-phase models
// (Halqa, StudentLessonProgress, StudentSurahProgress,
// SurahHifdhStudentSchedule — all Phase 2.5 Academic) are deferred.
// ═══════════════════════════════════════════════════════════════════════

// HR profile — 1:1 with User (login account). Kept separate from User so
// non-staff auth concerns (password, roles) stay independent of HR fields.
enum EmployeeType {
  TEACHER
  ADMIN
  OFFICE_STAFF
}

model Employee {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employeeCode  String
  employeeType  EmployeeType @default(OFFICE_STAFF)
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])
  dateOfJoining DateTime?
  dateOfBirth   DateTime?
  gender        Gender?
  address       String?
  qualification String?
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  leaves         Leave[]
  attendances    Attendance[]
  leaveQuotas    LeaveQuota[]
  appreciations  Appreciation[] @relation("AppreciationRecipient")
  awards         Award[]        @relation("AwardRecipient")
  teacherProfile Teacher?

  @@unique([branchId, employeeCode])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
}

// Hierarchical (self-referencing tree), branch-scoped.
model Department {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  employees Employee[]

  @@index([branchId])
  @@index([parentId])
}

// Hierarchical (self-referencing tree), branch-scoped.
model Designation {
  id        String        @id @default(cuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Designation?  @relation("DesignationHierarchy", fields: [parentId], references: [id])
  children  Designation[] @relation("DesignationHierarchy")
  status    ActiveStatus  @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  employees Employee[]

  @@index([branchId])
  @@index([parentId])
}

// NOTE: `academicYearId` is nullable, so the `@@unique` below does NOT
// guard against duplicate rows when it's null — Postgres treats every NULL
// as distinct in a unique index. Same gotcha as the FeeDemand fix, lower
// stakes here (quota rows are admin-managed, not auto-regenerated), so
// documented as a caveat rather than restructured.
// Lookup table for named leave types (Casual, Sick, Earned, ...), added
// alongside — not instead of — the free-text `leaveType` string still on
// Leave/LeaveQuota below: existing rows/UI keep working unchanged, while
// new mobile-app-api endpoints (#17 leaves/types, #21 my-leaves breakdown)
// get real ids/names to key off.
model LeaveType {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  leaves      Leave[]
  leaveQuotas LeaveQuota[]

  @@unique([branchId, name])
  @@index([branchId])
}

model LeaveQuota {
  id             String     @id @default(cuid())
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String // e.g. "casual", "sick", "earned" — kept as a string/lookup rather than enum for admin extensibility
  leaveTypeId    String?
  leaveTypeRef   LeaveType? @relation(fields: [leaveTypeId], references: [id])
  academicYearId String?
  totalDays      Decimal    @db.Decimal(5, 2)
  usedDays       Decimal    @default(0) @db.Decimal(5, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([employeeId, leaveType, academicYearId])
}

model Leave {
  id             String      @id @default(cuid())
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String
  leaveTypeId    String?
  leaveTypeRef   LeaveType?  @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  isHalfDay      Boolean     @default(false)
  reason         String?
  status         LeaveStatus @default(PENDING)
  relatedLeaveId String? // links half-day pairs / follow-up requests
  relatedLeave   Leave?      @relation("RelatedLeave", fields: [relatedLeaveId], references: [id])
  relatedLeaves  Leave[]     @relation("RelatedLeave")
  approvedById   String?
  approvalNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([branchId, status])
  @@index([employeeId])
}

// employeeId/studentId are both optional but mutually exclusive in
// practice: every existing (HR) attendance row has an employeeId, and
// student attendance rows (Mobile App API's activity report, no write path
// yet) have a studentId instead. Not enforced at the DB level (Prisma has
// no CHECK-constraint support here); application code only ever sets one.
model Attendance {
  id              String           @id @default(cuid())
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  studentId       String?
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  status          AttendanceStatus
  clockInAt       DateTime?
  clockOutAt      DateTime?
  clockInLat      Decimal?         @db.Decimal(9, 6)
  clockInLng      Decimal?         @db.Decimal(9, 6)
  remark          String?
  // Admin review of a PENDING_APPROVAL/REJECTED mobile clock-in — unset for
  // rows that were never through the review queue (e.g. bulkMark, self clock-in).
  reviewedById    String?
  reviewedBy      User?            @relation("AttendanceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@unique([studentId, date])
  @@index([branchId, date])
  @@index([studentId])
}

model Holiday {
