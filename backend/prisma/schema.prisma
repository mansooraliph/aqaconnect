// ═══════════════════════════════════════════════════════════════════════
// STUDENT MANAGEMENT (Phase 2.3)
//
// Same trimming rule as Configuration/HR: relations to LATER-phase models
// (HalqaStudent, StudentLessonProgress, SurahHifdhStudentSchedule,
// StudentSurahProgress, StudentExamResult — all Phase 2.5 Academic;
// FeeDemand, Payment — Phase 2.4 Fees) are deferred.
// ═══════════════════════════════════════════════════════════════════════

model Admission {
  id               String          @id @default(cuid())
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  applicantName    String
  guardianName     String?
  email            String?
  phone            String?
  dateOfBirth      DateTime?       @db.Date
  desiredClassId   String?
  desiredClass     AcademicClass?  @relation(fields: [desiredClassId], references: [id])
  status           AdmissionStatus @default(PENDING)
  reviewedById     String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdStudentId String? // set once approval provisions a Student record
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Back-relation for Student.admission (1:1) — the FK actually lives on
  // Student (admissionId), this is just the reverse pointer Prisma requires.
  student Student?

  @@index([branchId, status])
  @@index([desiredClassId])
}

// Student profile — 1:1 with User only when the student has portal/mobile
// login (self-service progress views, leave requests); userId is nullable
// to support students without their own login (guardian-managed only).
model Student {
  id             String       @id @default(cuid())
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  studentCode    String
  name           String
  dateOfBirth    DateTime?    @db.Date
  guardianName   String?
  guardianPhone  String?
  gender         Gender? // legacy Mobile App API: read off `users.gender` (student *is* a User there)
  address        String?
  qualification  String?
  joiningDate    DateTime?    @db.Date // legacy Mobile App API: student_details.joining_date
  hifdhStartDate DateTime?    @db.Date // legacy Mobile App API: student_details.hifdh_start_date (persisted there, only used transiently for schedule generation in the modern flow)
  admissionId    String?      @unique
  admission      Admission?   @relation(fields: [admissionId], references: [id])
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments      StudentEnrollment[]
  studentLeaves    StudentLeave[]
  halqaMemberships HalqaStudent[]
  lessonProgress   StudentLessonProgress[]
  surahSchedules   SurahHifdhStudentSchedule[]
  surahProgress    StudentSurahProgress[]
  examResults      StudentExamResult[]
  feeDemands       FeeDemand[]
  payments         Payment[]
  attendances      Attendance[]
  studentExams     StudentExam[]
  progressEntries  StudentSurahProgressEntry[]

  @@unique([branchId, studentCode])
  @@index([branchId, status])
}

// Mirrors legacy's flat per-student exam record (Mobile App API's
// addStudentExam/updateStudentExam) — deliberately separate from the
// modern class-wide Exam/StudentExamResult pair, which this legacy
// endpoint predates and doesn't reference. examId/scheduleId are loose,
// unenforced references (legacy validates them as plain integers with no
// `exists:` rule), so kept as plain optional strings here too.
model StudentExam {
  id         String              @id @default(cuid())
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examDate   DateTime            @db.Date
  examId     String?
  result     StudentExamOutcome?
  marks      Decimal?            @db.Decimal(5, 2)
  remarks    String?
  scheduleId String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([branchId])
  @@index([studentId])
}

enum StudentExamOutcome {
  PASS
  FAIL
  PREPARATION
}

// Mirrors legacy's per-ayah-range progress ledger (Mobile App API's
// StudentSurahProgressApiController) — deliberately separate from the
// existing cumulative StudentSurahProgress model (one row per
// student+surah), which the admin Hifdh module already depends on and
// updates. Legacy has MANY rows per student+surah (one per lesson
// attempt/range), each independently gradeable/verifiable — that shape
// doesn't fit the cumulative model without breaking it, so it's a new,
// parallel entity instead.
model StudentSurahProgressEntry {
  id          String              @id @default(cuid())
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surahId     String?
  surah       Surah?              @relation(fields: [surahId], references: [id])
  fromAyah    Int?
  toAyah      Int?
  // Day-number within the master target schedule this ayah was seeded from
  // (mirrors SurahHifdhStudentSchedule.day) — lets listings order by actual
  // schedule/pacing-plan sequence instead of falling back to fromAyah alone,
  // which doesn't reflect the plan's true order once revision passes revisit
  // earlier ayahs out of numeric sequence. Null for entries not seeded from
  // the schedule (e.g. mobile's Old Lesson/store-old-lesson-progress).
  day         Int?
  type        ProgressEntryType?
  status      ProgressEntryStatus @default(NOT_STARTED) // legacy: completion_status
  grade       ProgressEntryGrade?
  completedAt DateTime?
  verifiedAt  DateTime?
  remarks     String?
  // Filename only — no upload/storage subsystem in this schema (same gap
  // as elsewhere); accepted for request-shape compatibility, never
  // actually written to disk/S3.
  remarkFile  String?

  // "Old Lesson" / "Juzh Lesson" range fields — legacy's newer columns for
  // ranges that span multiple surahs/juz/pages rather than a single
  // surah's ayah range.
  surahFrom     Int?
  surahFromAyah Int?
  surahTo       Int?
  surahToAyah   Int?
  juzuhFrom     Int?
  juzuhTo       Int?
  pageFrom      Int?
  pageTo        Int?

  addedById       String?
  addedBy         User?   @relation("ProgressEntryAddedBy", fields: [addedById], references: [id])
  lastUpdatedById String?
  lastUpdatedBy   User?   @relation("ProgressEntryLastUpdatedBy", fields: [lastUpdatedById], references: [id])
  verifiedById    String?
  verifiedBy      User?   @relation("ProgressEntryVerifiedBy", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([studentId, surahId])
  @@index([studentId, type])
  @@index([studentId, status])
}

enum ProgressEntryType {
  NEW_LESSON
  JUZH_LESSON
  OLD_LESSON
}

enum ProgressEntryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum ProgressEntryGrade {
  VERY_GOOD
  GOOD
  AVERAGE
  BAD
}

model StudentEnrollment {
  id                         String                   @id @default(cuid())
  studentId                  String
  student                    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicClassSectionYearId String
  academicClassSectionYear   AcademicClassSectionYear @relation(fields: [academicClassSectionYearId], references: [id], onDelete: Cascade)
  status                     EnrollmentStatus         @default(ACTIVE)
  enrolledAt                 DateTime                 @default(now())
  transferredFromId          String? // self-relation to the enrollment this one replaced, for transfer history
  transferredFrom            StudentEnrollment?       @relation("Transfer", fields: [transferredFromId], references: [id])
  transferredTo              StudentEnrollment[]      @relation("Transfer")
  withdrawnAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@unique([studentId, academicClassSectionYearId])
  @@index([academicClassSectionYearId, status])
  @@index([studentId])
}

// Student-facing leave-request workflow (StudentLeaveApiController in the
// old system). Named `StudentLeave` — deliberately distinct from `Leave`
// above (the HR/Employee leave workflow); the two are unrelated domains
// that happen to share the word "leave". One row per calendar day of leave
// (old system creates one row per day in a date range), matching
// `applyLeave`'s documented behavior.
model StudentLeave {
  id              String             @id @default(cuid())
  branchId        String
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leaveDate       DateTime           @db.Date
  reason          String
  leaveType       String? // "home" | "hostal" per old system's enum, kept as string for admin extensibility
  status          StudentLeaveStatus @default(PENDING)
  creationRemarks String?
  approvalRemarks String?
  createdById     String? // self-applied (student) or teacher/admin-created on the student's behalf
  approvedById    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([branchId, status])
  @@index([studentId, leaveDate])
}

enum FeeFrequency {
  ONE_TIME
  INSTALLMENTS
}

enum FeeDemandStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// Unifies the old system's split behavior (payments got ledger rows via
// FeeDemandAdjustment, discounts silently mutated the parent FeeDemand
// instead — a real gap in the old design). All four types now produce a
// PaymentAllocation row, so discounts/waivers/refunds are auditable too.
enum PaymentAllocationType {
  PAYMENT
  DISCOUNT
  WAIVER
  REFUND
}

// ═══════════════════════════════════════════════════════════════════════
// FEES (Phase 2.4)
//
// Shape reflects the Phase 1 audit's "Fee Demand Generation & Payment —
// Deep Dive" recommendations: 3-tier structure/installment/demand, unified
// PaymentAllocation with a type enum, persisted demand status, sequenced
// installments, real FeeType FK, receipt as a record. Same trimming rule
// as prior phases: no relations to later-phase models remain (none apply
// here — Fees is the last domain with forward references to build out).
// ═══════════════════════════════════════════════════════════════════════

model FeeType {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  feeStructures FeeStructure[]

  @@unique([branchId, name])
}

model FeeStructure {
  id              String        @id @default(cuid())
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicClassId String
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id])
  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id])
  feeTypeId       String // real FK — old schema stored a loose free-text label
  feeType         FeeType       @relation(fields: [feeTypeId], references: [id])
  name            String
  // `amount`/`dueDate` are authoring-time convenience fields for the
  // ONE_TIME case. The generation service copies them onto a single, real
  // FeeInstallment row (sequenceNo 1) at structure-creation time — see
  // FeeInstallment's comment for the idempotency reasoning. They're never
  // read directly at demand-generation time; the installment row is always
  // the source of truth.
  amount          Decimal       @db.Decimal(10, 2)
  frequency       FeeFrequency  @default(ONE_TIME)
  dueDate         DateTime?     @db.Date
  currency        String        @default("INR")
  status          ActiveStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  installments FeeInstallment[]
  demands      FeeDemand[]

  @@index([branchId, academicClassId, academicYearId])
}

// IDEMPOTENCY FIX (schema review Blocking #4): frequency = ONE_TIME
// FeeStructures always get exactly one real FeeInstallment row (sequenceNo
// 1, name e.g. "Full Payment", amount/dueDate copied from FeeStructure) —
// created by the generation service at structure-creation time — instead
// of leaving FeeDemand.installmentId null for one-time fees. Postgres
// unique indexes treat every NULL as distinct, so a nullable installmentId
// would silently allow duplicate one-time demands; this keeps FeeDemand's
// `@@unique` below meaningful for both fee types.
model FeeInstallment {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  sequenceNo     Int
  name           String
  amount         Decimal      @db.Decimal(10, 2)
  dueDate        DateTime     @db.Date
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  demands FeeDemand[]

  @@unique([feeStructureId, sequenceNo])
}

// One row per student x installment. Generation must be idempotent/
// transactional (unique constraint below) and must never blind-overwrite a
// demand that already has allocations against it — enforced in the service
// layer, not the schema (per the inventory's recommendation).
model FeeDemand {
  id             String          @id @default(cuid())
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure    @relation(fields: [feeStructureId], references: [id])
  // Required, not nullable (schema review Blocking #4 fix): every
  // FeeStructure — ONE_TIME included — always has a real FeeInstallment row
  // to point to, so this is never null and the @@unique below is a genuine
  // idempotency guard for one-time fees too.
  installmentId  String
  installment    FeeInstallment  @relation(fields: [installmentId], references: [id])
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  demandAmount   Decimal         @default(0) @db.Decimal(10, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  adjustedAmount Decimal         @default(0) @db.Decimal(10, 2) // running total of allocations applied
  dueDate        DateTime?       @db.Date
  status         FeeDemandStatus @default(PENDING) // persisted, kept in sync by allocation writes
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  allocations PaymentAllocation[]

  @@unique([studentId, feeStructureId, installmentId, academicYearId])
  @@index([branchId, status])
  @@index([studentId])
  @@index([dueDate])
  // Added in the Phase 2.6 index review — the demand-generation engine
  // (FeeDemandsService.previewGeneration/generate) queries by
  // [feeStructureId, studentId: {in: [...]}] on every call, and this was the
  // one genuinely hot, unindexed lookup found in that pass.
  @@index([feeStructureId])
}

// One row per payment event (receipt-level), can fan out into multiple
// PaymentAllocation rows (FIFO across pending demands).
model Payment {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime      @db.Date
  mode          PaymentMode
  reference     String?
  proofFileUrl  String?
  status        PaymentStatus @default(PENDING) // new system genuinely honors PENDING, unlike the old system's immediate COMPLETED
  receiptNumber String?       @unique // generated via a DB sequence, not regex-parsed like the old system
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  allocations PaymentAllocation[]
  receipt     Receipt?

  @@index([branchId, studentId])
  @@index([paymentDate])
}

// Unified ledger: every payment, discount, waiver, and refund produces a
// row here (the old system's discounts bypassed this table entirely and
// mutated FeeDemand directly — a real gap this design fixes).
model PaymentAllocation {
  id          String                @id @default(cuid())
  feeDemandId String
  feeDemand   FeeDemand             @relation(fields: [feeDemandId], references: [id], onDelete: Cascade)
  paymentId   String? // null for pure discounts/waivers not tied to a Payment event
  payment     Payment?              @relation(fields: [paymentId], references: [id])
  type        PaymentAllocationType
  amount      Decimal               @db.Decimal(10, 2)
  reason      String? // required for DISCOUNT/WAIVER/REFUND
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([feeDemandId])
  @@index([paymentId])
}

// Generated document tracked as a record rather than a bare path string.
model Receipt {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileUrl     String
  generatedAt DateTime @default(now())
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum HifdhProgressStatus {
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

// SurahHifdhStudentSchedule's own status vocabulary, matching legacy's
// completion_status exactly. Deliberately a separate enum from
// HifdhProgressStatus (used by StudentSurahProgress, the cumulative
// aggregate) so the two concerns don't get entangled — NEEDS_REVIEW is the
// old "COMPLETED" (student done, awaiting teacher check) and this
// COMPLETED is the old "VERIFIED" (teacher-confirmed, terminal).
enum HifdhScheduleStatus {
  PENDING
  IN_PROGRESS
  NEEDS_REVIEW
  COMPLETED
}

enum MemorizationQuality {
  EXCELLENT
  GOOD
  AVERAGE
  NEEDS_IMPROVEMENT
  NOT_ASSESSED
}

enum ExamResultStatus {
  DRAFT
  PUBLISHED
}

// ═══════════════════════════════════════════════════════════════════════
// ACADEMIC (Phase 2.5) — the last functional domain. No forward references
// remain deferred anywhere in this file after this section.
// ═══════════════════════════════════════════════════════════════════════

model Lesson {
  id               String          @id @default(cuid())
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lessonStageId    String
  lessonStage      LessonStage     @relation(fields: [lessonStageId], references: [id])
  lessonSubStageId String?
  lessonSubStage   LessonSubStage? @relation(fields: [lessonSubStageId], references: [id])
  title            String
  description      String?
  sortOrder        Int             @default(0)
  status           ActiveStatus    @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  progress StudentLessonProgress[]

  @@index([branchId, lessonStageId, sortOrder])
  @@index([lessonSubStageId])
}

model StudentLessonProgress {
  id           String               @id @default(cuid())
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       LessonProgressStatus @default(NOT_STARTED)
  completedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   Teacher?             @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId, status])
  @@index([lessonId])
}

// A "Halqa" = a Quran study circle/group led by a teacher.
model Halqa {
  id              String         @id @default(cuid())
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  teacherId       String?
  teacher         Teacher?       @relation(fields: [teacherId], references: [id])
  startDate       DateTime?      @db.Date // legacy Mobile App API: start_date
  currentClassId  String? // legacy Mobile App API: current_class
  currentClass    AcademicClass? @relation(fields: [currentClassId], references: [id])
  status          ActiveStatus   @default(ACTIVE)
  addedById       String? // legacy Mobile App API: audit trail (not used by the modern configuration UI)
  addedBy         User?          @relation("HalqaAddedBy", fields: [addedById], references: [id])
  lastUpdatedById String?
  lastUpdatedBy   User?          @relation("HalqaLastUpdatedBy", fields: [lastUpdatedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  students       HalqaStudent[]
  hifdhSchedules SurahHifdhStudentSchedule[]

  @@index([branchId])
  @@index([teacherId])
  @@index([currentClassId])
}

// Roster join table (student-to-Halqa assignment).
model HalqaStudent {
  id         String    @id @default(cuid())
  halqaId    String
  halqa      Halqa     @relation(fields: [halqaId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  @@unique([halqaId, studentId])
  @@index([studentId])
}

// Per-student Hifdh (memorization) schedule generated from a
// SurahTargetSchedule row. Field set matches the legacy
// `surah_hifd_student_schedules` table; company_id/added_by/
// last_updated_by/deleted_at dropped (same rationale as elsewhere — global
// audit-by/soft-delete pattern isn't used in this schema), and
// surah_number/surah_name/surah_name_en dropped in favor of the existing
// surahId relation. `schedule_no`/`day` are gone too — SurahTargetSchedule
// no longer groups by scheduleNo, so `scheduledDate` alone identifies the
// day, and `surahTargetId` links back to the exact source row instead.
model SurahHifdhStudentSchedule {
  id                       String                      @id @default(cuid())
  studentId                String
  student                  Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  halqaId                  String? // legacy: halqa_id
  halqa                    Halqa?                      @relation(fields: [halqaId], references: [id])
  surahTargetId            String? // legacy: surah_target_id — the source SurahTargetSchedule row
  surahTarget              SurahTargetSchedule?        @relation(fields: [surahTargetId], references: [id])
  // surahId/fromAyah/toAyah are nullable because milestone rows ("Exam",
  // "Exam preparation") generated from a SurahTargetSchedule row with no
  // surah portion carry no memorization portion either — examName carries
  // the descriptive text for those instead.
  surahId                  String?
  surah                    Surah?                      @relation(fields: [surahId], references: [id])
  teacherId                String?
  teacher                  Teacher?                    @relation(fields: [teacherId], references: [id])
  pageNumberFrom           Int?
  pageNumberTo             Int?
  lineFrom                 Int?
  lineTo                   Int?
  portionDescription       String?
  fromAyah                 Int? // legacy: verse_from
  toAyah                   Int? // legacy: verse_to
  scheduledDate            DateTime                    @db.Date
  // Increments per student each time their Hifdh schedule is regenerated
  // (legacy: schedule_no) — lets a student have multiple schedule
  // "versions" over time, e.g. after a curriculum restart.
  scheduleNo               Int                         @default(1)
  // Sequence day-number within a schedule generation (legacy: day) —
  // copied from the source SurahTargetSchedule.dayNumber, used for display
  // ordering only (scheduledDate already encodes the actual calendar date).
  day                      Int?
  rescheduledFromId        String?
  rescheduledFrom          SurahHifdhStudentSchedule?  @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo            SurahHifdhStudentSchedule[] @relation("Reschedule")
  status                   HifdhScheduleStatus         @default(PENDING) // legacy: completion_status
  completionDate           DateTime?                   @db.Date
  completionPercentage     Float?
  memorizationQuality      MemorizationQuality?
  teacherNotes             String?
  studentNotes             String?
  revisionCount            Int                         @default(0)
  lastRevisionDate         DateTime?                   @db.Date
  nextRevisionDue          DateTime?                   @db.Date
  estimatedDurationMinutes Int? // legacy: estimated_duration (time)
  actualDurationMinutes    Int? // legacy: actual_duration (time)
  startedAt                DateTime?
  completedAt              DateTime?
  difficultyLevel          DifficultyLevel?
  priority                 SchedulePriority?
  scheduleType             String? // legacy: schedule_type — plain text: "Hifd" / "Preparation" / "Exam"
  examName                 String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([studentId, status])
  @@index([studentId, scheduleNo])
  @@index([surahId])
  @@index([teacherId])
  @@index([halqaId])
  @@index([surahTargetId])
}

// Cumulative per-student, per-surah progress (separate from the schedule —
// this is the aggregate/summary record used for leaderboards/comparisons).
model StudentSurahProgress {
  id             String              @id @default(cuid())
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surahId        String
  surah          Surah               @relation(fields: [surahId], references: [id])
  ayahsCompleted Int                 @default(0)
  status         HifdhProgressStatus @default(IN_PROGRESS)
  completedAt    DateTime?
  verifiedAt     DateTime?
  verifiedById   String?
  verifiedBy     Teacher?            @relation("SurahVerifiedBy", fields: [verifiedById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([studentId, surahId])
  @@index([studentId, status])
  @@index([surahId])
}

model ExamType {
  id        String       @id @default(cuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  exams Exam[]

  @@unique([branchId, name])
}

model Exam {
  id         String       @id @default(cuid())
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  examTypeId String
  examType   ExamType     @relation(fields: [examTypeId], references: [id])
  name       String
  examDate   DateTime     @db.Date
  maxMarks   Decimal      @default(100) @db.Decimal(6, 2)
  status     ActiveStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  results StudentExamResult[]

  @@index([branchId, examTypeId])
}

model StudentExamResult {
  id            String           @id @default(cuid())
  examId        String
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Decimal          @db.Decimal(6, 2)
  remark        String?
  status        ExamResultStatus @default(DRAFT)
  enteredById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([examId, studentId])
  @@index([studentId])
}

// One row per call into any `/api/app/*` (Mobile App API) route — powers
// the admin-facing usage-history page. Deliberately denormalized (no FK to
// User) so logs survive account deletion and stay cheap to write on every
// request; userId/username are a point-in-time snapshot, not a live join.
model MobileApiRequestLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([path])
}

// ═══════════════════════════════════════════════════════════════════════
// NOTIFICATIONS (in-app inbox + push via FCM)
// ═══════════════════════════════════════════════════════════════════════

// A user may be signed in on several devices at once, so this is one row
// per (user, device) rather than a single token column on User.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String? // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum NotificationType {
  ANNOUNCEMENT
  RECITATION_PROGRESS
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([branchId])
}
