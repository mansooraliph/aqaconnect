# Postgres (docker-compose)
POSTGRES_USER=aqa_dev
POSTGRES_PASSWORD=aqa_dev_password
POSTGRES_DB=aqa_v2
POSTGRES_HOST_PORT=5433

# Backend
DATABASE_URL=postgresql://aqa_dev:aqa_dev_password@localhost:5433/aqa_v2?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
PORT=3000
